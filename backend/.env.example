# StudyMate AI — Backend Environment
# Copy this to .env and fill in real values. Never commit .env.

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- App ---
APP_ENV=development
# Real accounts and cookie sessions are enabled by default.
AUTH_MODE=session
SESSION_DAYS=7
# AUTH_MODE=development explicitly enables test identities in development only.
# Change these to match your demo identity.
DEV_USER_ID=dev_student_001
DEV_USER_NAME=Dev Student

# --- Storage ---
# Path to the SQLite database file (relative to backend/).
DATABASE_PATH=.local-data/studymate.db
# Directory where uploaded files are stored (relative to backend/).
STORAGE_PATH=.local-data/files

# --- Limits ---
MAX_UPLOAD_MB=5
MAX_VIDEO_MB=50
MAX_VIDEO_MINUTES=60
VIDEO_TIMEOUT_SECONDS=180
MAX_PDF_PAGES=25
MAX_TEXT_CHARS=80000

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Rate limits (requests per hour per user) ---
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_QUIZ=20
RATE_LIMIT_SEED=10
